# =============================================================
# LedgerLoop environment template
#
# DEMO MODE (quickstart, no external accounts):
#   Leave the Supabase vars / LLM_API_KEY below EMPTY and run
#   `docker compose up --build`. The backend auto-detects the missing
#   Supabase backend, runs on a local SQLite DB, and seeds the sample
#   dataset — open http://localhost:3000 and hit "Enter demo dashboard".
#
# FULL MODE:
#   Fill in Supabase + Google + LLM keys. Demo mode disables itself
#   automatically once a real Supabase backend is configured.
# =============================================================

# --- Demo mode ---
# Auto-enabled when no real Supabase backend is set. Leave DEMO_MODE empty for
# auto-detection, or force DEMO_MODE=0 / DEMO_MODE=1 explicitly.
# DEMO_OWNER_ID is the local demo user.
DEMO_MODE=
DEMO_OWNER_ID=demo-owner
DEMO_SAMPLES_DIR=data/demo-samples
SEED_DEMO=true

# --- Supabase (Postgres + Google Auth) ---
# From Project Settings -> API and Project Settings -> Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

# --- Google OAuth (paste these into the Supabase Auth -> Providers -> Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Structuring LLM + image OCR (Mistral; any OpenAI-compatible provider works) ---
# Leave empty in demo mode — the offline extractor is used instead.
LLM_PROVIDER=mistral
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
LLM_BASE_URL=https://api.mistral.ai/v1
# Mistral OCR model for camera/scanned invoice photos (uses LLM_API_KEY).
OCR_MODEL=mistral-ocr-latest
# Groq/Llama 3.3 alternative:
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Telegram ingestion worker (docker `telegram` service) ---
# Set a token to enable forwarding invoices to the bot; leave empty to skip.
TELEGRAM_BOT_TOKEN=

# --- Month-end email ---
# When true, month-end emails are rendered + logged but not actually sent.
EMAIL_DRY_RUN=true
# Default recipient for month-end emails when a shopkeeper has no CA set.
CA_EMAIL_DEFAULT=

# --- Backend ---
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=data/uploads

# Frontend (server-side fetch base URL)
BACKEND_URL=http://localhost:8000

# Frontend (public, baked into the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Frontend demo mode: leave EMPTY for auto-detection (demo runs whenever the
# Supabase browser keys above are empty). NEXT_PUBLIC_DEMO_MODE=1 forces demo
# even with real keys — clear it when setting up full mode.
NEXT_PUBLIC_DEMO_MODE=
